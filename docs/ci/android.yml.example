name: Android APK

# Every push to main builds an installable APK (Actions → this run → Artifacts).
# Pushing a tag like v1.2.0 also attaches the APK to a GitHub Release for easy download on a phone.
on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
          cache: gradle

      - run: npm ci
      - run: npm run lint
      - run: npm test

      # web bundle without the service worker, copied into the Android project
      - run: npm run build:android

      - name: Build APK
        working-directory: android
        run: ./gradlew assembleDebug --no-daemon

      - name: Name the APK
        run: cp android/app/build/outputs/apk/debug/app-debug.apk teyvat-nihongo-${{ github.run_number }}.apk

      - uses: actions/upload-artifact@v4
        with:
          name: teyvat-nihongo-apk
          path: teyvat-nihongo-${{ github.run_number }}.apk

      - name: Attach to release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: teyvat-nihongo-${{ github.run_number }}.apk
